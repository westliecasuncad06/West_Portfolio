# Copy to .env.local for local development. On Vercel, add these under
# Project Settings > Environment Variables. Never commit real values.

# Gmail account that sends the contact form emails.
GMAIL_USER=westliecasuncad06@gmail.com

# 16-character Gmail App Password (Google Account > Security > App passwords).
# Requires 2-Step Verification. Spaces are fine; they're stripped.
GMAIL_APP_PASSWORD=

# Inbox that receives contact form messages. Defaults to westliecasuncad06@gmail.com.
CONTACT_TO_EMAIL=

# Public URL of the site, used for metadata and the sitemap.
# Optional on Vercel: the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=
